# Go build artifacts
/bin/
*.exe
*.test
*.out
coverage.*
node_modules/

# Python caches
__pycache__/
*.py[cod]
*$py.class
# install-prereqs.sh / owpengram-server.sh create this for the panel's packages.
# Untracked and unignored, it was one `git clean -fd` away from being deleted.
/.venv/

# 本地环境 / 密钥（server RSA private key 必须持久化，但禁止入库）
.env
.env.*
!.env.example
*.local
*.pem
*.key
/secrets/
/data/*
!/data/langpack/
!/data/langpack/**
logs/
tmp/
.gocache/
.tdesktop-e2e/

# start-server.sh/bat generated files
.public_ip
.link_prefix
.secrets
.docker_naming
.db_naming
.server_panel.json

# Local-only destructive dev tool (deletes .env, data/, Docker volumes) --
# never belongs in the repo.
/wipe-server.bat

# IDE
.idea/
.vscode/
*.exe~
